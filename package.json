{
  "name": "shot-timer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "phone:cert": "node scripts/phone-cert.mjs",
    "phone:cert-server": "node scripts/phone-cert-server.mjs",
    "preview:phone": "vite preview --mode phone --host 0.0.0.0 --port 5174",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "version:next": "node scripts/bump-version.mjs",
    "check": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
